# ==========================================
# Abhiraj Yadav Portfolio - Backend Config
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# For local MongoDB: mongodb://127.0.0.1:27017/abhiraj_portfolio
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/abhiraj_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/abhiraj_portfolio

# Email Configuration (Nodemailer)
# Primary recipient who will receive visitor contact emails
RECIPIENT_EMAIL=abhirajyadav303@gmail.com

# Service provider: 'gmail' or 'smtp'
EMAIL_SERVICE=gmail

# If using Gmail, generate an "App Password" (NOT your regular password):
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Go to "App passwords" -> Create one for "Portfolio Mailer"
# 3. Paste the 16-character password below (without spaces)
EMAIL_USER=abhirajyadav303@gmail.com
EMAIL_PASS=your_16_character_app_password

# Optional: Custom SMTP (if EMAIL_SERVICE=smtp)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=your_smtp_password

# Security / Admin (Optional API key to access contact submissions via GET /api/contact)
ADMIN_API_KEY=abhiraj_super_secret_admin_key_2026
